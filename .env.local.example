
# Database (PostgreSQL with pgvector extension)
# DATABASE_URL does NOT belong here — put it in `.env` (see `.env.example`).
# The Prisma CLI reads only `.env`, so a URL set here is invisible to
# `prisma migrate` / `prisma db seed`, and those commands would silently fall
# through to whatever `.env` holds — including the shared remote dev database.

# Encryption key for stored mailbox passwords and API keys
# (generate with: openssl rand -hex 32; never change it once set)
EMAIL_ENCRYPTION_KEY=

# Mailtrap Sandbox - optional dev/staging email testing (alternative to Resend)
# Generate a token from your Mailtrap inbox settings: https://mailtrap.io
MAILTRAP_API_KEY=

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional for local dev — Email OTP works without it)
GOOGLE_ID=
GOOGLE_SECRET=

#SMTP (port 465, TLS) — EMAIL_FROM is also the sender of login codes
EMAIL_HOST=smtp.resend.com
EMAIL_FROM=info@domain.com
EMAIL_USERNAME=smtp@domain.com
EMAIL_PASSWORD=

# Allow mailbox (IMAP/SMTP) and plugin HTTP connections to private IPs
MAIL_ALLOW_PRIVATE_HOSTS=
PLUGIN_HTTP_ALLOW_PRIVATE_HOSTS=


#NEXT ENV for Client part of App
NEXT_PUBLIC_APP_NAME=NextCRM
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domain for the fallback invoice sender (invoices@<domain>) when EMAIL_FROM is empty
NEXT_PUBLIC_APP_DOMAIN=
NEXT_PUBLIC_NEXT_VERSION="14.0.4"
NEXT_PUBLIC_GITHUB_REPO_URL="https://github.com/pdovhomilja/nextcrm-app"
NEXT_PUBLIC_GITHUB_ISSUES_URL=""
NEXT_PUBLIC_GITHUB_TOKEN=


#NEXTCRM (generate with: openssl rand -base64 32)
NEXTCRM_TOKEN=

#AI (empty = use keys saved in the admin panel)
#All AI features go through the AI router (lib/llm/ai-router.ts): providers with a key are
#tried in order OpenAI -> Gemini -> OpenRouter -> Anthropic, several models each, with fallback.
#Embeddings / semantic search use Gemini (gemini-embedding-001).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
#GEMINI_API_KEY (GOOGLE_API_KEY is also accepted)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
#Optional: provider order, e.g. GEMINI,OPENROUTER,OPENAI,ANTHROPIC
AI_PROVIDER_ORDER=
#Optional: fallback model lists per provider and tier (comma-separated, tried in order), e.g.
#OPENROUTER_MODELS=openai/gpt-5-mini,google/gemini-2.5-flash
#GEMINI_MODELS_LIGHT=gemini-2.5-flash-lite,gemini-2.5-flash
#ANTHROPIC_MODELS_THINKING=claude-sonnet-4-6
#Web search (LinkedIn profile research for AI outreach) needs a Gemini or OpenRouter key.
#Optional: AI outreach messages generated per minute in bulk (default 5, fits the Gemini free tier)
OUTREACH_PER_MINUTE=

#Discord
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.com/invite/Dd4Aj6S4Dz"

#Resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@domain.com

#INNGEST (local dev server: INNGEST_DEV=1, see docker-compose.dev.yml)
INNGEST_DEV=1
INNGEST_ID=nextcrm
INNGEST_APP_NAME=NextCRM
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# UploadThing file storage (https://uploadthing.com/dashboard > API Keys > V7)
UPLOADTHING_TOKEN=


#Playwright E2E Test Credentials
# The test user is created automatically when you run: pnpm prisma db seed
# E2E tests use Email OTP — the test setup intercepts OTP from the database
TEST_USER_EMAIL=admin@domain.com

# Required for E2B enrichment
E2B_API_KEY=e2b_***
E2B_ENRICHMENT_TEMPLATE=nextcrm-enrichment
